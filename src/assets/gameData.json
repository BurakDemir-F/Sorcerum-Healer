  "introPages": [
    {
      "id": "intro_welcome_1",
      "title": "Sınır Söğüt Köyüne Hoş Geldin",
      "text": "Hoş geldin şifacı. Uzun zamandır köyümüze bir şifacı bulunmadı. Köyün sınırında bir druid bulunur ama o bizle çok ilgilenmez. Sınır Söğüt eski bir palanka tahkimatı içinde ufak bir köydür. Çoğunlukla hayvancılıkla uğraşır ve tahıl yetiştiririz. ",
      "imageUrl": "assets/intro_1.png"
    },
    {
      "id": "intro_welcome_2",
      "title": "Canavarlar",
      "text": "Hayvan otlakları palanka dışında kaldığı için hayvanlarımızı otlatmaya çıkardığımızda çok sayıda canavar saldırır. Bu sebeple senin şifacı yeteneklerin ve iksirlerin bize merhem olacak.",
      "imageUrl": ""
    },
    {
      "id": "intro_welcome_3",
      "title": "Druid Seren",
