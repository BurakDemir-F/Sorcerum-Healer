  "storylines": [
    {
      "id": "story_landlord",
      "characterName": "Tahsildar Kazım",
      "description": "Köyün beyine çalışan, palankadaki kiraları toplayan ve borç affetmeyen kurallara bağlı devlet görevlisi.",
      "avatarUrl": "",
      "nodes": [
        {
          "id": "node_landlord_demand",
          "npcText": "Selam şifacı! Köyün beyinin tahsildarıyım ben. Palankanın içindeki dükkan kirasını (100 Altın) tahsil etmeye geldim.",
          "day": 7,
          "choices": [
            {
              "text": "Kiramı Öde (100 Altın Öde)",
              "nextNodeId": "node_landlord_thanks",
              "reqGold": 100
            },
            {
              "text": "Şu an ödeyemiyorum, borç yaz beyimize.",
              "nextNodeId": "node_landlord_angry"
            }
          ]
        },
        {
          "id": "node_landlord_thanks",
          "npcText": "Güzel, akıllı bir şifacı. Palankamızın kapısı sana her zaman açık kalacaktır. İyi çalışmalar.",
          "day": 7,
          "choices": [
            {
              "text": "Teşekkürler, iyi günler Kazım Bey.",
              "nextNodeId": null
            }
          ]
        },
        {
          "id": "node_landlord_angry",
          "npcText": "Yine mi borç?! Bak burası devlet kapısı. Kazandığın her altın doğrudan benim borç defterime kesilecek, palanka kanunudur bu!",
          "day": 7,
          "choices": [
            {
              "text": "Anlıyorum, yapacak bir şey yok...",
              "nextNodeId": null
            }
          ]
        }
      ]
    },
    {
      "id": "story_d_shepherdNarin",
      "characterName": "Çoban Kız Narin",
      "description": "",
      "avatarUrl": "👤",
      "nodes": [
        {
          "id": "node_d_shepherdNarin_1",
          "npcText": "Merhaba, ben Narin. Köyün koyunlarını güderim. Dükkanın hayırlı olsun.",
          "day": 1,
          "choices": [
            {
              "text": "Peki. İsimleri pek hatırlamam.",
              "nextNodeId": null
            },
            {
              "text": "Merhaba, seninle tanıştığıma memnun oldum Narin. Nasılsın?",
              "nextNodeId": "node_d_shepherdNarin_2300"
            }
          ]
        },
        {
          "id": "node_d_shepherdNarin_2300",
          "npcText": "Bugün bir kuzu doğdu. Üşümesin diye yavruyu sırtımda taşıyıp eve götürdüm. Biraz üşüttüm. Bana iyi gelecek bir içeceğin var mı?",
          "diseaseId": "d_freezing",
          "dynamicSuccessNodeId": "",
          "dynamicFailNodeId": "",
          "day": 1,
          "choices": [
            {
              "text": "Tabii, sana güzel bir kış çayı demleyeyim, fiyatı 18 altın.",
              "nextNodeId": null,
              "rewardGold": 18
            },
            {
              "text": "Madem bugün bir kuzu doğdu ve sen onu sırtında taşıdın o zaman bir kış çayını hakettin. Zaten ilk müşterim de sensin.",
              "nextNodeId": "node_d_shepherdNarin_8642",
              "reqPotion": "d_freezingElixir",
              "reqPotionCount": 1
            },
            {
              "text": "Elimde böyle bir içecek yok.",
              "nextNodeId": null
            }
          ]
        },
        {
          "id": "node_d_shepherdNarin_8642",
          "npcText": "Geçen günki kış çayını çok beğendim. Koyun güderken senin için biraz söğüt kabuğu çıkardım.",
          "diseaseId": "",
          "dynamicSuccessNodeId": "",
          "dynamicFailNodeId": "",
          "day": 3,
          "choices": [
            {
              "text": "Teşekkür ederim.",
              "nextNodeId": null,
              "rewardPlantId": "d_willowShell",
              "rewardPlantCount": 2
            }
          ]
        }
      ]
    },
    {
      "id": "story_d_carpenterDursun",
      "characterName": "Marangoz Usta Dursun",
      "description": "",
      "avatarUrl": "👤",
      "nodes": [
        {
          "id": "node_d_carpenterDursun_1",
          "npcText": "Selam olsun. Ben köyün marangozu Dursun. Bir haftanın iki günü palanka'nın tamiratıyla geçiyor. Eski bir palanka bir tarafı tamir etsen bir tarafı çöküyor.",
          "day": 1,
          "choices": [
            {
              "text": "Palanka nedir usta?",
              "nextNodeId": "node_d_carpenterDursun_5531"
            },
            {
              "text": "Nasıl yardımcı olabilirim usta?",
              "nextNodeId": "node_d_carpenterDursun_1056"
            }
          ]
        },
        {
          "id": "node_d_carpenterDursun_1056",
          "npcText": "Palankayı tamir ederken elimi kestim, elinde biraz kesik merhemi ya da kanı durduracak bir şeyler var mı?",
          "diseaseId": "d_wound",
          "day": 1,
          "choices": [
            {
              "text": "Kesik merhemim var usta, 19 altındır.",
              "nextNodeId": null,
              "reqPotion": "d_woundSerum",
              "reqPotionCount": 1,
              "rewardGold": 19
            }
          ]
        },
        {
          "id": "node_d_carpenterDursun_5531",
          "npcText": "Palanka köyün etrafını saran ahşap tahkimattır. Yani bir nevi köy suru. Demir ardıç dediğimiz büyülü ağaçtan yapılmıştır. Ama çok eski, babamın babası zamanında yapılmış, o yüzden şimdi dökülüyor. Ben de onu tamir ederken elimi kestim. Kesik merhemin var mı?",
          "diseaseId": "d_wound",
          "dynamicSuccessNodeId": "",
          "dynamicFailNodeId": "",
          "day": 1,
          "choices": [
            {
              "text": "Kesik merhemim var usta, fiyatı 19 altın.",
              "nextNodeId": null,
              "reqPotion": "d_woundSerum",
              "reqPotionCount": 1,
              "rewardGold": 19
            }
          ]
        }
      ]
    }
  ],
